PORT=3100 # Change this to the specific port of the station (e.g. 3105 for sterilizer)
NODE_ENV=development

# Database Configuration (for the specific station)
DB_HOST=localhost
DB_USER=kip_station_user
DB_PASSWORD=CHANGE_THIS_PASSWORD
DB_NAME=mewah_kip_{station}

# JWT Secret (MUST match other services)
JWT_SECRET=CHANGE_THIS_TO_LONG_RANDOM_STRING

# Redis (for PLC data pub/sub)
REDIS_URL=redis://:REDIS_PASSWORD@localhost:6379
REDIS_CHANNEL=kip:plc:data

# CORS
CORS_ORIGINS=http://localhost:5173
