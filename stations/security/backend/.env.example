PORT=3101
NODE_ENV=development

# Database Configuration (for the specific station)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_PASSWORD
DB_NAME=mewah_security
STATION_SLUG=security

# CCTV Python upstream on the same server
SECURITY_AI_HOST=127.0.0.1
SECURITY_AI_PORT=4101

# JWT Secret (MUST match other services)
JWT_SECRET=CHANGE_THIS_TO_LONG_RANDOM_STRING

# Redis (for PLC data pub/sub)
REDIS_URL=redis://:REDIS_PASSWORD@localhost:6379
REDIS_CHANNEL=kip:plc:data

# CORS
CORS_ORIGINS=http://localhost:5173
