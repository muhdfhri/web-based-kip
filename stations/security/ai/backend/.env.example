# Environment Configuration for Security AI Microservice
PORT=4101
FLASK_ENV=production
SECRET_KEY=CHANGE_THIS_TO_LONG_RANDOM_STRING

# Database Settings
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_PASSWORD
DB_NAME_AI=mewah_security_ai
DB_NAME_GENERAL=mewah_security

# Redis Settings
REDIS_URL=redis://127.0.0.1:6379/0

# Default RTSP URL Hikvision
DEFAULT_RTSP_URL=rtsp://USER:PASSWORD@NVR_IP:554/Streaming/Channels/101

# Grid uses shared substream readers; main snapshots retain original resolution.
CCTV_PREFER_SUBSTREAM=true
CCTV_PREVIEW_WIDTH=640
CCTV_PREVIEW_FPS=30
CCTV_JPEG_QUALITY=72
