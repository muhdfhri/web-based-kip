# ═══════════════════════════════════════════════════════════════
# MEWAH-KIP — Environment Variables
# Copy file ini ke .env atau set sebagai environment variable
# ═══════════════════════════════════════════════════════════════

# ── MySQL ──
MYSQL_ROOT_PASSWORD=root_change_me

# ── Redis ──
REDIS_PASSWORD=redis_change_me
REDIS_URL=redis://:redis_change_me@localhost:6379
REDIS_CHANNEL=kip:plc:data

# ── JWT ──
JWT_SECRET=jwt_change_me_in_production
JWT_EXPIRES_IN=7d

# ── CORS ──
CORS_ORIGINS=http://localhost:5173

# ── Main Service (port 3001) ──
DB_HOST=localhost
DB_USER_AUTH=kip_auth
DB_PASSWORD_AUTH=auth_change_me
DB_NAME_AUTH=mewah_auth
DB_USER_CONFIG=kip_config
DB_PASSWORD_CONFIG=config_change_me
DB_NAME_CONFIG=mewah_config

# ── PLC Collector (port 3999) ──
DB_USER=kip_snap7
DB_PASSWORD=snap7_change_me
DB_NAME=mewah_plc
POLL_INTERVAL_MS=200

# ── Realtime Service (port 3002) ──
DB_USER=kip_realtime
DB_PASSWORD=realtime_change_me
DB_NAME=mewah_plc

# ── Station Service (port 3003) ──
DB_USER=kip_station
DB_PASSWORD=station_change_me
DB_NAME=mewah_station

# ── Stations (port 3101-3116) ──
DB_USER=kip_station_user
DB_PASSWORD=CHANGE_THIS_PASSWORD

# ── Alarm Service (port 3300) ──
DB_USER=kip_alarm
DB_PASSWORD=alarm_change_me
DB_NAME=mewah_alarm

# ── Contacts Service (port 3400) ──
DB_USER=kip_contacts
DB_PASSWORD=contacts_change_me
DB_NAME=mewah_contacts

# ── Maintenance Service (port 3200) ──
DB_USER=kip_maintenance
DB_PASSWORD=maintenance_change_me
DB_NAME=mewah_maintenance
